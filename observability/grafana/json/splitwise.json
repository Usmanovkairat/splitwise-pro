{
  "schemaVersion": 39,
  "uid": "splitwise-observability",
  "title": "SplitWise Pro — Application Observability",
  "description": "Compare environments with the same queries. Each isolated Compose deployment reports its own environment. Creation totals represent estimated increases over the selected time range.",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "development,production",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests per second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "h": 7,
        "w": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "splitwise-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (environment) (rate(splitwise_http_requests_total{environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{environment}}",
          "instant": false
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP 5xx error rate",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "h": 7,
        "w": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "splitwise-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (environment) (rate(splitwise_api_errors_total{environment=~\"$environment\"}[$__rate_interval])) or on (environment) 0 * sum by (environment) (rate(splitwise_http_requests_total{environment=~\"$environment\"}[$__rate_interval]))) / (sum by (environment) (rate(splitwise_http_requests_total{environment=~\"$environment\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{environment}}",
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "title": "API latency",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "h": 7,
        "w": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "splitwise-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (environment, le) (rate(splitwise_http_request_duration_seconds_bucket{environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{environment}} p50",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (environment, le) (rate(splitwise_http_request_duration_seconds_bucket{environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{environment}} p95",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (environment, le) (rate(splitwise_http_request_duration_seconds_bucket{environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{environment}} p99",
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Service availability",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 7,
        "h": 7,
        "w": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "splitwise-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (environment, probe) (avg_over_time(probe_success{environment=~\"$environment\"}[5m]))",
          "legendFormat": "{{environment}} {{probe}}",
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "title": "Groups created",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 14,
        "h": 7,
        "w": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "splitwise-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (environment) (increase(splitwise_groups_created_total{environment=~\"$environment\"}[$__range]))",
          "legendFormat": "{{environment}}",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Expenses created",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 14,
        "h": 7,
        "w": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "splitwise-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (environment) (increase(splitwise_expenses_created_total{environment=~\"$environment\"}[$__range]))",
          "legendFormat": "{{environment}}",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Settlements created",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 21,
        "h": 7,
        "w": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "splitwise-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (environment) (increase(splitwise_settlements_created_total{environment=~\"$environment\"}[$__range]))",
          "legendFormat": "{{environment}}",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Expense creation latency",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 21,
        "h": 7,
        "w": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "splitwise-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (environment, le) (rate(splitwise_expense_creation_duration_seconds_bucket{environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{environment}} p95",
          "instant": false
        }
      ]
    },
    {
      "id": 9,
      "title": "Balance calculation latency",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 28,
        "h": 7,
        "w": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "splitwise-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (environment, le) (rate(splitwise_balance_calculation_duration_seconds_bucket{environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{environment}} p95",
          "instant": false
        }
      ]
    }
  ]
}
